{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-linked hypothesis map",
  "type": "object",
  "required": ["schema_version", "sources", "events", "hypotheses", "relations", "agent_contract"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sources": {"type": "object", "additionalProperties": {"type": "object", "required": ["kind"]}},
    "events": {"type": "array", "items": {"type": "object", "required": ["id", "phase", "trigger", "action", "observation", "limitation", "sources", "evidence_kind"]}},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "family", "title", "origin", "claim", "history", "status", "interpretation", "next_action", "sources", "transitions", "jury_verdict", "production_replay"],
        "properties": {
          "id": {"type": "string", "pattern": "^H[0-9]{2,}$"},
          "family": {"enum": ["consensus", "resources", "static", "method"]},
          "status": {"enum": ["negative_within_scope", "oracle_rejected", "needs_production_replay", "reopened", "impact_unproven", "static_candidate", "revised_by_guard", "harness_artifacts_documented", "new_review_question"]},
          "history": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "transitions": {
            "type": "array",
            "items": {"type": "object", "required": ["event", "state", "reason", "evidence_kind", "sources"], "properties": {"event": {"type": ["string", "null"]}, "evidence_kind": {"enum": ["journal_claim", "code_observation", "official_interpretation", "reproduced_by_agent"]}}}
          }
        }
      }
    },
    "relations": {"type": "array", "items": {"type": "object", "required": ["from", "to", "type", "label", "provenance"]}},
    "agent_contract": {"type": "object", "required": ["history_policy", "confirmation_requires", "next_iteration"]}
  }
}
